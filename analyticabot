import React, { useState, useEffect, useCallback, useMemo } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, BarChart, Bar, Area, AreaChart, ScatterChart, Scatter, RadarChart, PolarGrid, PolarAngleAxis, PolarRadiusAxis, Radar } from 'recharts';
import { TrendingUp, TrendingDown, DollarSign, BarChart3, Activity, AlertTriangle, Target, Brain, Calculator, Zap, Star, Shield, PieChart, Globe } from 'lucide-react';
import * as math from 'mathjs';

const InvestmentAnalystBot = () => {
  const [selectedAsset, setSelectedAsset] = useState('AAPL');
  const [assetType, setAssetType] = useState('stocks');
  const [analysisMode, setAnalysisMode] = useState('comprehensive');
  const [timeframe, setTimeframe] = useState('1D');
  
  // Market data simulation
  const [marketData, setMarketData] = useState({});
  const [priceHistory, setPriceHistory] = useState([]);
  const [fundamentals, setFundamentals] = useState({});
  const [technicalIndicators, setTechnicalIndicators] = useState({});
  const [predictions, setPredictions] = useState({});
  const [sentimentData, setSentimentData] = useState({});
  const [riskMetrics, setRiskMetrics] = useState({});

  // Asset configurations
  const assetTypes = {
    stocks: ['AAPL', 'GOOGL', 'MSFT', 'TSLA', 'AMZN', 'NVDA', 'META', 'NFLX'],
    forex: ['EUR/USD', 'GBP/USD', 'USD/JPY', 'AUD/USD', 'USD/CAD', 'USD/CHF', 'NZD/USD'],
    crypto: ['BTC/USD', 'ETH/USD', 'BNB/USD', 'ADA/USD', 'SOL/USD', 'DOT/USD'],
    bonds: ['US10Y', 'US30Y', 'DE10Y', 'JP10Y', 'UK10Y', 'US2Y'],
    commodities: ['GOLD', 'SILVER', 'OIL', 'COPPER', 'WHEAT', 'CORN'],
    indices: ['SPX', 'NASDAQ', 'DAX', 'FTSE', 'NIKKEI', 'HSI']
  };

  // Generate realistic market data
  const generateMarketData = useCallback((asset, type) => {
    const basePrice = {
      stocks: 150 + Math.random() * 300,
      forex: 0.8 + Math.random() * 0.4,
      crypto: 20000 + Math.random() * 40000,
      bonds: 3 + Math.random() * 4,
      commodities: 1500 + Math.random() * 1000,
      indices: 3000 + Math.random() * 2000
    }[type];

    const volatility = {
      stocks: 0.02,
      forex: 0.008,
      crypto: 0.05,
      bonds: 0.005,
      commodities: 0.03,
      indices: 0.015
    }[type];

    return {
      currentPrice: basePrice,
      change24h: (Math.random() - 0.5) * basePrice * volatility * 2,
      volume: Math.random() * 10000000,
      marketCap: type === 'stocks' ? basePrice * (1000000 + Math.random() * 5000000) : null,
      volatility: volatility * 100
    };
  }, []);

  // Generate price history with realistic patterns
  const generatePriceHistory = useCallback((basePrice, periods = 100) => {
    const history = [];
    let price = basePrice;
    const trend = (Math.random() - 0.5) * 0.001;
    
    for (let i = 0; i < periods; i++) {
      const volatility = 0.02;
      const change = (Math.random() - 0.5) * volatility + trend;
      price = Math.max(0.01, price * (1 + change));
      
      const date = new Date();
      date.setHours(date.getHours() - (periods - i));
      
      history.push({
        time: date.toLocaleTimeString(),
        timestamp: date.getTime(),
        price: price,
        volume: Math.random() * 1000000,
        high: price * (1 + Math.random() * 0.01),
        low: price * (1 - Math.random() * 0.01),
        open: price * (0.99 + Math.random() * 0.02)
      });
    }
    
    return history;
  }, []);

  // Calculate technical indicators
  const calculateTechnicalIndicators = useCallback((priceData) => {
    if (priceData.length < 50) return {};
    
    const prices = priceData.map(d => d.price);
    const volumes = priceData.map(d => d.volume);
    
    // Moving Averages
    const sma20 = prices.slice(-20).reduce((a, b) => a + b) / 20;
    const sma50 = prices.slice(-50).reduce((a, b) => a + b) / 50;
    const ema12 = prices.slice(-12).reduce((a, b) => a + b) / 12;
    const ema26 = prices.slice(-26).reduce((a, b) => a + b) / 26;
    
    // RSI Calculation
    const gains = [];
    const losses = [];
    for (let i = 1; i < Math.min(15, prices.length); i++) {
      const change = prices[prices.length - i] - prices[prices.length - i - 1];
      if (change > 0) gains.push(change);
      else losses.push(Math.abs(change));
    }
    const avgGain = gains.reduce((a, b) => a + b, 0) / gains.length || 0;
    const avgLoss = losses.reduce((a, b) => a + b, 0) / losses.length || 1;
    const rsi = 100 - (100 / (1 + avgGain / avgLoss));
    
    // MACD
    const macd = ema12 - ema26;
    const macdSignal = macd * 0.9; // Simplified
    const macdHistogram = macd - macdSignal;
    
    // Bollinger Bands
    const sma20Array = [];
    for (let i = 19; i < prices.length; i++) {
      sma20Array.push(prices.slice(i-19, i+1).reduce((a, b) => a + b) / 20);
    }
    const stdDev = Math.sqrt(sma20Array.slice(-20).reduce((a, b) => a + Math.pow(b - sma20, 2), 0) / 20);
    const upperBand = sma20 + (stdDev * 2);
    const lowerBand = sma20 - (stdDev * 2);
    
    // Stochastic Oscillator
    const highestHigh = Math.max(...priceData.slice(-14).map(d => d.high));
    const lowestLow = Math.min(...priceData.slice(-14).map(d => d.low));
    const currentPrice = prices[prices.length - 1];
    const stochK = ((currentPrice - lowestLow) / (highestHigh - lowestLow)) * 100;
    
    // Volume indicators
    const avgVolume = volumes.slice(-20).reduce((a, b) => a + b) / 20;
    const volumeRatio = volumes[volumes.length - 1] / avgVolume;
    
    return {
      sma20, sma50, ema12, ema26,
      rsi: Math.min(100, Math.max(0, rsi)),
      macd, macdSignal, macdHistogram,
      upperBand, lowerBand,
      stochK: Math.min(100, Math.max(0, stochK)),
      volumeRatio,
      avgVolume
    };
  }, []);

  // Generate fundamental analysis data
  const generateFundamentals = useCallback((asset, type) => {
    if (type === 'stocks') {
      return {
        pe: 15 + Math.random() * 20,
        pb: 1 + Math.random() * 4,
        roe: 10 + Math.random() * 20,
        roa: 5 + Math.random() * 15,
        debtToEquity: Math.random() * 2,
        currentRatio: 1 + Math.random() * 2,
        quickRatio: 0.5 + Math.random() * 1.5,
        grossMargin: 20 + Math.random() * 50,
        operatingMargin: 5 + Math.random() * 25,
        netMargin: 2 + Math.random() * 20,
        revenueGrowth: -10 + Math.random() * 30,
        earningsGrowth: -15 + Math.random() * 40,
        dividendYield: Math.random() * 6,
        payoutRatio: Math.random() * 80
      };
    } else if (type === 'forex') {
      return {
        interestRateDiff: -2 + Math.random() * 4,
        inflationDiff: -1 + Math.random() * 3,
        gdpGrowthDiff: -2 + Math.random() * 4,
        currentAccountBalance: -5 + Math.random() * 10,
        politicalStability: 50 + Math.random() * 50,
        tradeBalance: -10 + Math.random() * 20
      };
    }
    return {};
  }, []);

  // Advanced price prediction algorithm
  const generatePredictions = useCallback((priceData, indicators, fundamentals) => {
    if (priceData.length < 20) return {};
    
    const currentPrice = priceData[priceData.length - 1].price;
    const priceChanges = [];
    
    for (let i = 1; i < priceData.length; i++) {
      priceChanges.push((priceData[i].price - priceData[i-1].price) / priceData[i-1].price);
    }
    
    const avgReturn = priceChanges.reduce((a, b) => a + b, 0) / priceChanges.length;
    const volatility = Math.sqrt(priceChanges.reduce((a, b) => a + Math.pow(b - avgReturn, 2), 0) / priceChanges.length);
    
    // Technical Score (0-100)
    let technicalScore = 50;
    if (indicators.rsi) {
      if (indicators.rsi < 30) technicalScore += 20;
      else if (indicators.rsi > 70) technicalScore -= 20;
      
      if (indicators.macd > indicators.macdSignal) technicalScore += 10;
      else technicalScore -= 10;
      
      if (currentPrice > indicators.sma20) technicalScore += 15;
      else technicalScore -= 15;
      
      if (indicators.sma20 > indicators.sma50) technicalScore += 10;
      else technicalScore -= 10;
    }
    
    // Fundamental Score (0-100)
    let fundamentalScore = 50;
    if (fundamentals.pe && fundamentals.pe < 20) fundamentalScore += 10;
    if (fundamentals.roe && fundamentals.roe > 15) fundamentalScore += 10;
    if (fundamentals.revenueGrowth && fundamentals.revenueGrowth > 5) fundamentalScore += 15;
    
    // Combined prediction
    const combinedScore = (technicalScore * 0.4 + fundamentalScore * 0.6);
    
    // Price targets
    const shortTermTarget = currentPrice * (1 + (combinedScore - 50) * 0.002);
    const mediumTermTarget = currentPrice * (1 + (combinedScore - 50) * 0.005);
    const longTermTarget = currentPrice * (1 + (combinedScore - 50) * 0.01);
    
    // Confidence levels
    const confidence = Math.min(95, Math.max(5, 60 + Math.abs(combinedScore - 50)));
    
    return {
      technicalScore: Math.min(100, Math.max(0, technicalScore)),
      fundamentalScore: Math.min(100, Math.max(0, fundamentalScore)),
      combinedScore: Math.min(100, Math.max(0, combinedScore)),
      shortTermTarget,
      mediumTermTarget,
      longTermTarget,
      confidence,
      trend: combinedScore > 60 ? 'Bullish' : combinedScore < 40 ? 'Bearish' : 'Neutral',
      volatility: volatility * 100,
      avgReturn: avgReturn * 100
    };
  }, []);

  // Risk assessment
  const calculateRiskMetrics = useCallback((priceData, predictions) => {
    if (priceData.length < 30) return {};
    
    const returns = [];
    for (let i = 1; i < priceData.length; i++) {
      returns.push((priceData[i].price - priceData[i-1].price) / priceData[i-1].price);
    }
    
    const avgReturn = returns.reduce((a, b) => a + b) / returns.length;
    const variance = returns.reduce((a, b) => a + Math.pow(b - avgReturn, 2), 0) / returns.length;
    const volatility = Math.sqrt(variance);
    
    // Value at Risk (5% worst case)
    const sortedReturns = returns.sort((a, b) => a - b);
    const var5 = sortedReturns[Math.floor(sortedReturns.length * 0.05)];
    
    // Maximum Drawdown
    let maxPrice = priceData[0].price;
    let maxDrawdown = 0;
    for (const point of priceData) {
      if (point.price > maxPrice) maxPrice = point.price;
      const drawdown = (maxPrice - point.price) / maxPrice;
      if (drawdown > maxDrawdown) maxDrawdown = drawdown;
    }
    
    // Sharpe Ratio (assuming risk-free rate of 3%)
    const riskFreeRate = 0.03 / 365; // Daily
    const excessReturn = avgReturn - riskFreeRate;
    const sharpeRatio = volatility > 0 ? excessReturn / volatility : 0;
    
    // Risk Rating
    let riskRating = 'Medium';
    if (volatility < 0.01) riskRating = 'Low';
    else if (volatility > 0.03) riskRating = 'High';
    
    return {
      volatility: volatility * 100,
      var5: var5 * 100,
      maxDrawdown: maxDrawdown * 100,
      sharpeRatio,
      riskRating,
      avgReturn: avgReturn * 100 * 365, // Annualized
      beta: 0.8 + Math.random() * 0.4 // Simplified
    };
  }, []);

  // Update data when asset changes
  useEffect(() => {
    const updateData = () => {
      const market = generateMarketData(selectedAsset, assetType);
      const history = generatePriceHistory(market.currentPrice);
      const indicators = calculateTechnicalIndicators(history);
      const fundData = generateFundamentals(selectedAsset, assetType);
      const preds = generatePredictions(history, indicators, fundData);
      const risks = calculateRiskMetrics(history, preds);
      
      setMarketData(market);
      setPriceHistory(history);
      setTechnicalIndicators(indicators);
      setFundamentals(fundData);
      setPredictions(preds);
      setRiskMetrics(risks);
      
      // Sentiment simulation
      setSentimentData({
        bullish: 30 + Math.random() * 40,
        bearish: 20 + Math.random() * 30,
        neutral: 30 + Math.random() * 20,
        fearGreedIndex: 20 + Math.random() * 60,
        socialSentiment: 40 + Math.random() * 40
      });
    };

    updateData();
    const interval = setInterval(updateData, 5000);
    return () => clearInterval(interval);
  }, [selectedAsset, assetType, generateMarketData, generatePriceHistory, calculateTechnicalIndicators, generateFundamentals, generatePredictions, calculateRiskMetrics]);

  // Signal strength calculation
  const getSignalStrength = useMemo(() => {
    if (!predictions.combinedScore) return { strength: 0, signal: 'HOLD', color: 'text-yellow-400' };
    
    const score = predictions.combinedScore;
    if (score >= 75) return { strength: score, signal: 'STRONG BUY', color: 'text-green-500' };
    if (score >= 60) return { strength: score, signal: 'BUY', color: 'text-green-400' };
    if (score >= 40) return { strength: score, signal: 'HOLD', color: 'text-yellow-400' };
    if (score >= 25) return { strength: score, signal: 'SELL', color: 'text-red-400' };
    return { strength: score, signal: 'STRONG SELL', color: 'text-red-500' };
  }, [predictions.combinedScore]);

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-900 via-blue-900 to-purple-900 text-white p-6">
      <div className="max-w-7xl mx-auto space-y-6">
        {/* Header */}
        <div className="flex justify-between items-center mb-8">
          <div>
            <h1 className="text-4xl font-bold bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 bg-clip-text text-transparent">
              AI Investment Analyst
            </h1>
            <p className="text-gray-300 mt-2">Advanced Multi-Asset Price Trajectory Analysis</p>
          </div>
          <div className="flex items-center gap-2 bg-green-600/20 px-4 py-2 rounded-lg border border-green-500/30">
            <Brain className="text-green-400" size={20} />
            <span className="text-green-400 font-medium">AI Analysis Active</span>
          </div>
        </div>

        {/* Asset Selection */}
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
          <div>
            <label className="block text-sm text-gray-300 mb-2">Asset Type</label>
            <select 
              value={assetType}
              onChange={(e) => setAssetType(e.target.value)}
              className="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2"
            >
              <option value="stocks">Stocks</option>
              <option value="forex">Forex</option>
              <option value="crypto">Cryptocurrency</option>
              <option value="bonds">Bonds</option>
              <option value="commodities">Commodities</option>
              <option value="indices">Indices</option>
            </select>
          </div>
          <div>
            <label className="block text-sm text-gray-300 mb-2">Asset</label>
            <select 
              value={selectedAsset}
              onChange={(e) => setSelectedAsset(e.target.value)}
              className="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2"
            >
              {assetTypes[assetType]?.map(asset => (
                <option key={asset} value={asset}>{asset}</option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-sm text-gray-300 mb-2">Timeframe</label>
            <select 
              value={timeframe}
              onChange={(e) => setTimeframe(e.target.value)}
              className="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2"
            >
              <option value="1D">1 Day</option>
              <option value="1W">1 Week</option>
              <option value="1M">1 Month</option>
              <option value="3M">3 Months</option>
              <option value="1Y">1 Year</option>
            </select>
          </div>
          <div>
            <label className="block text-sm text-gray-300 mb-2">Analysis Mode</label>
            <select 
              value={analysisMode}
              onChange={(e) => setAnalysisMode(e.target.value)}
              className="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2"
            >
              <option value="comprehensive">Comprehensive</option>
              <option value="technical">Technical Only</option>
              <option value="fundamental">Fundamental Only</option>
              <option value="sentiment">Sentiment Focus</option>
            </select>
          </div>
        </div>

        {/* Main Stats Dashboard */}
        <div className="grid grid-cols-1 md:grid-cols-5 gap-6">
          {/* Current Price */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Current Price</p>
                <p className="text-2xl font-bold">${marketData.currentPrice?.toFixed(4)}</p>
                <p className={`text-sm ${marketData.change24h >= 0 ? 'text-green-400' : 'text-red-400'}`}>
                  {marketData.change24h >= 0 ? '+' : ''}{((marketData.change24h / marketData.currentPrice) * 100)?.toFixed(2)}%
                </p>
              </div>
              <DollarSign className="text-blue-400" size={32} />
            </div>
          </div>

          {/* AI Signal */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">AI Signal</p>
                <p className={`text-xl font-bold ${getSignalStrength.color}`}>
                  {getSignalStrength.signal}
                </p>
                <p className="text-sm text-gray-400">
                  {getSignalStrength.strength?.toFixed(0)}/100
                </p>
              </div>
              <Target className={getSignalStrength.color.replace('text-', 'text-')} size={32} />
            </div>
          </div>

          {/* Risk Level */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Risk Level</p>
                <p className={`text-xl font-bold ${
                  riskMetrics.riskRating === 'Low' ? 'text-green-400' :
                  riskMetrics.riskRating === 'Medium' ? 'text-yellow-400' : 'text-red-400'
                }`}>
                  {riskMetrics.riskRating}
                </p>
                <p className="text-sm text-gray-400">
                  Vol: {riskMetrics.volatility?.toFixed(1)}%
                </p>
              </div>
              <Shield className="text-purple-400" size={32} />
            </div>
          </div>

          {/* Confidence */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Confidence</p>
                <p className="text-xl font-bold text-cyan-400">
                  {predictions.confidence?.toFixed(0)}%
                </p>
                <p className="text-sm text-gray-400">Prediction</p>
              </div>
              <Star className="text-cyan-400" size={32} />
            </div>
          </div>

          {/* Trend */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Trend</p>
                <p className={`text-xl font-bold ${
                  predictions.trend === 'Bullish' ? 'text-green-400' :
                  predictions.trend === 'Bearish' ? 'text-red-400' : 'text-yellow-400'
                }`}>
                  {predictions.trend}
                </p>
                <p className="text-sm text-gray-400">Direction</p>
              </div>
              {predictions.trend === 'Bullish' ? 
                <TrendingUp className="text-green-400" size={32} /> :
                predictions.trend === 'Bearish' ?
                <TrendingDown className="text-red-400" size={32} /> :
                <Activity className="text-yellow-400" size={32} />
              }
            </div>
          </div>
        </div>

        {/* Charts Section */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* Price Chart with Predictions */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <h3 className="text-xl font-semibold mb-4 flex items-center gap-2">
              <BarChart3 className="text-blue-400" size={20} />
              Price Analysis & Forecast
            </h3>
            <div className="h-80">
              <ResponsiveContainer width="100%" height="100%">
                <LineChart data={priceHistory.slice(-50)}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#374151" />
                  <XAxis dataKey="time" stroke="#9CA3AF" fontSize={12} />
                  <YAxis stroke="#9CA3AF" fontSize={12} />
                  <Tooltip 
                    contentStyle={{ 
                      backgroundColor: '#1F2937', 
                      border: '1px solid #374151',
                      borderRadius: '8px'
                    }} 
                  />
                  <Line type="monotone" dataKey="price" stroke="#3B82F6" strokeWidth={2} dot={false} />
                  {technicalIndicators.sma20 && (
                    <Line type="monotone" dataKey="sma20" stroke="#10B981" strokeWidth={1} strokeDasharray="5 5" dot={false} />
                  )}
                </LineChart>
              </ResponsiveContainer>
            </div>
            
            {/* Price Targets */}
            <div className="mt-4 grid grid-cols-3 gap-4">
              <div className="text-center">
                <p className="text-xs text-gray-400">Short Term</p>
                <p className="text-sm font-bold text-green-400">
                  ${predictions.shortTermTarget?.toFixed(2)}
                </p>
              </div>
              <div className="text-center">
                <p className="text-xs text-gray-400">Medium Term</p>
                <p className="text-sm font-bold text-yellow-400">
                  ${predictions.mediumTermTarget?.toFixed(2)}
                </p>
              </div>
              <div className="text-center">
                <p className="text-xs text-gray-400">Long Term</p>
                <p className="text-sm font-bold text-purple-400">
                  ${predictions.longTermTarget?.toFixed(2)}
                </p>
              </div>
            </div>
          </div>

          {/* Technical Indicators Radar */}
          <div className="bg-gray-800/50 backdrop-blur rounded-xl p-6 border border-gray-600/30">
            <h3 className="text-xl font-semibold mb-4 flex items-center gap-2">
              <Activity className="text-green-400" size={20} />
              Technical Analysis
            </h3>
            <div className="h-80">
              <ResponsiveContainer width="100%" height="100%">
                <RadarChart data={[
                  { indicator: 'RSI', value: technicalIndicators.rsi || 0, fullMark: 100 },
                  { indicator: 'MACD', value: Math.abs(technicalIndicators.macd || 0) * 10, fullMark: 100 },
                  { indicator: 'Volume', value: (technicalIndicators.volumeRatio || 1) * 50, fullMark: 100 },
                  { indicator: 'Momentum', value: predictions.technicalScore || 50, fullMark: 100 },
                  { indicator: 'Trend', value: technicalIndicators.sma20 > technicalIndicators.sma50 ? 75 : 25, fullMark: 100 }
                ]}>
                  <PolarGrid />
                  <PolarAngleAxis dataKey="indicator" />
                  <PolarRadiusAxis angle={90} domain={[0, 100]} />
                  <Radar
                    name="Technical Score"
                    dataKey="value"
                    stroke="#8884d8"
                    fill="#8884d8"
                    fillOpacity={0.3}
                  />
                </RadarChart>
              </ResponsiveContainer>
            </div>
            
            <div className="mt-4 space-y-2">
              <div className="flex justify-between">
                <span className="text-sm text-gray-400">RSI:</span>
                <span className={`text-sm font-bold ${
                  technicalIndicators.rsi > 70 ? 'text-re